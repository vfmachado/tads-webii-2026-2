# Copie para `.env` (que NÃO vai para o git) e ajuste.
#   cp .env.example .env
#
# Os scripts leem este arquivo e passam a senha ao Terraform como
# TF_VAR_db_password. Use só letras e números (8+): a senha entra na DATABASE_URL.

POSTGRES_USER=tarefas
POSTGRES_PASSWORD=troqueEstaSenha123
POSTGRES_DB=tarefas

# Usado só pelo docker-compose.yml (desenvolvimento sem Kubernetes).
# 8091 para não colidir com a Aula 12 (8090) nem com o cluster k3d (8013).
WEB_PORT=8091
