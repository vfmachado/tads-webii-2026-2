{
  "name": "aula11-relatorios-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aula 11 - API de relatórios: recebe o pedido, enfileira no Kafka (report.requested) e acompanha o resultado (report.completed / report.failed).",
  "scripts": {
    "dev": "node --disable-warning=TimeoutNegativeWarning --import tsx src/index.ts",
    "dev:watch": "node --disable-warning=TimeoutNegativeWarning --import tsx --watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=TimeoutNegativeWarning dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
