{
  "name": "aula11-notificacoes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aula 11 - Notificações: consome report.completed / report.failed e avisa o usuário por e-mail.",
  "scripts": {
    "dev": "node --disable-warning=TimeoutNegativeWarning --import tsx src/index.ts",
    "dev:watch": "node --disable-warning=TimeoutNegativeWarning --import tsx --watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=TimeoutNegativeWarning dist/index.js"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "nodemailer": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
