# Copie para `.env` (`cp .env.example .env`).
PORT=3009

# Estratégia de envio de e-mail: "console" ou "nodemailer"
EMAIL_STRATEGY=console

# --- Usadas apenas quando EMAIL_STRATEGY=nodemailer ---
# Para testes, crie uma conta gratuita em https://ethereal.email (botão
# "Create Ethereal Account") e copie usuário/senha abaixo. Os e-mails não
# são entregues de verdade; o link de pré-visualização aparece no console.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true e uma
# "senha de app" (https://myaccount.google.com/apppasswords) em SMTP_PASS.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu.usuario@ethereal.email
SMTP_PASS=sua-senha
EMAIL_FROM="Cadastro WebII <no-reply@example.com>"
