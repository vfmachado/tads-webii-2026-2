{
  "name": "aula12-tarefas-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aula 12 - API de tarefas: Express + PostgreSQL, com migrations, health checks e testes em camadas.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test \"test/unit/**/*.test.ts\"",
    "test:integration": "tsx --test \"test/integration/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/migrate.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
