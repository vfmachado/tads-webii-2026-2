# Copie para `.env` (que NÃO vai para o git) e ajuste.
#   cp .env.example .env
#
# Em produção, gere uma senha forte:  openssl rand -base64 24
# Use só letras e números (ou codifique em URL), porque a senha entra na DATABASE_URL.

POSTGRES_USER=tarefas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=tarefas

# Porta publicada no computador/servidor
WEB_PORT=8090

# Versão das imagens. O scripts/deploy.sh define isso sozinho (hash do commit).
# TAG=local
